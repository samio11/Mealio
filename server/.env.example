# =============================================================================
# Mess Management SaaS - Backend Environment (EXAMPLE - copy to .env)
# Never commit real secrets. Generate strong values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# =============================================================================

# App
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL). Prisma 7 uses @prisma/adapter-pg
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Auth (Better-Auth) + session/JWT secrets
BETTER_AUTH_SECRET=replace-with-strong-random-value
BETTER_AUTH_URL=http://localhost:5000
ACCESS_TOKEN_SECRET=replace-with-strong-random-value
REFRESH_TOKEN_SECRET=replace-with-strong-random-value
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d
BETTER_AUTH_SESSION_TOKEN_EXPIRES_IN=1d
BETTER_AUTH_SESSION_TOKEN_UPDATE_AGE=1d

# Email / SMTP
# For Gmail, use an app password (not your regular account password).
EMAIL_SENDER_SMTP_HOST=smtp.gmail.com
EMAIL_SENDER_SMTP_PORT=465
EMAIL_SENDER_SMTP_USER=
EMAIL_SENDER_SMTP_PASS=
EMAIL_SENDER_SMTP_FROM=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/callback/google

# Cloudinary (private media)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Super Admin (seeded on first start)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me

# AI (OpenRouter primary)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free
AI_TEXT_MODEL=baidu/ernie-5.5-flash-preview:free
GEMINI_API_KEY=
GROQ_API_KEY=
