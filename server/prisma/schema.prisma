// Prisma 7 schema for the Mess Management SaaS.
// Generator: the v7 `prisma-client` generator (ESM/CJS selectable) — output is committed-adjacent.
// Datasource URL is supplied by prisma7.config.ts (datasource.url).
//
// Money is ALWAYS stored as integer poisha (BigInt) — 1 BDT = 100 poisha. Never floats.
// All mess-owned rows carry messId for tenant isolation.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// AUTH (Better-Auth) — model names must stay User/Session/Account/Verification
// so the Prisma adapter resolves prisma.user / prisma.session / prisma.account /
// prisma.verification. Table names are mapped to snake_case.
// =============================================================================

enum PlatformRole {
  USER
  ADMIN
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  phone         String?      @unique
  phoneVerified Boolean      @default(false)
  platformRole  PlatformRole @default(USER)
  blockedAt     DateTime?
  locale        String       @default("bn")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sessions        Session[]
  accounts        Account[]
  memberships     MessMembership[] @relation("UserMemberships")
  createdMesses   Mess[]           @relation("MessCreatedBy")
  auditLogs       AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// =============================================================================
// MESS / TENANCY
// =============================================================================

enum MessRole {
  MANAGER
  MEMBER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

model Mess {
  id         String    @id @default(uuid())
  name       String
  area       String?
  address    String?
  currency   String    @default("BDT")
  timezone   String    @default("Asia/Dhaka")
  createdById String
  createdBy  User      @relation("MessCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  memberships  MessMembership[]
  invitations  MessInvitation[]
  months       MessMonth[]
  groceryItems GroceryItem[]
  groceryPrices GroceryPrice[]
  deposits     Deposit[]
  expenses     Expense[]
  bazarEntries BazarEntry[]
  duties       BazarDuty[]
  menus        DailyMenu[]
  mealRecords  MealRecord[]
  guestMealRecords GuestMealRecord[]
  media        Media[]
  aiExtractions AIExtraction[]
  adjustments  MemberAdjustment[]
  auditLogs    AuditLog[]

  @@index([createdById])
  @@map("messes")
}

model MessMembership {
  id             String           @id @default(uuid())
  messId         String
  mess           Mess             @relation(fields: [messId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation("UserMemberships", fields: [userId], references: [id], onDelete: Restrict)
  role           MessRole         @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  displayName    String?
  phone          String?
  isDutyEligible Boolean          @default(true)
  joinedAt       DateTime         @default(now())
  leftAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  mealRecords   MealRecord[]
  guestMealRecords GuestMealRecord[]
  deposits      Deposit[]
  bazarEntries  BazarEntry[]      @relation("BazarBuyer")
  duties        BazarDuty[]       @relation("DutyAssignee")
  adjustments   MemberAdjustment[]
  allocations   ExpenseAllocation[]
  utilityPayments UtilityPayment[]

  @@unique([messId, userId])
  @@index([userId])
  @@index([messId, status])
  @@map("mess_memberships")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model MessInvitation {
  id             String           @id @default(uuid())
  messId         String
  mess           Mess             @relation(fields: [messId], references: [id], onDelete: Cascade)
  email          String?
  phone          String?
  role           MessRole         @default(MEMBER)
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  invitedUserId  String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([messId, status])
  @@index([email])
  @@map("mess_invitations")
}

// =============================================================================
// MONTHS / MEALS
// =============================================================================

enum MonthStatus {
  OPEN
  CLOSED
}

enum MealRatePolicy {
  EXPENSES_OVER_MEALS
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

enum MealRecordStatus {
  ON
  OFF
}

enum MealChangeSource {
  MEMBER
  MANAGER_OVERRIDE
  SYSTEM_DEFAULT
}

model MessMonth {
  id                 String         @id @default(uuid())
  messId             String
  mess               Mess           @relation(fields: [messId], references: [id], onDelete: Cascade)
  year               Int
  month              Int
  status             MonthStatus    @default(OPEN)
  openingCashPoisha  BigInt         @default(0)
  budgetPoisha       BigInt         @default(0)
  mealRatePolicy     MealRatePolicy @default(EXPENSES_OVER_MEALS)
  settingsSnapshot   Json?
  closedAt           DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  mealSettings  MealTypeSetting[]
  mealRecords   MealRecord[]
  guestMealRecords GuestMealRecord[]
  menus         DailyMenu[]
  deposits      Deposit[]
  expenses      Expense[]
  bazarEntries  BazarEntry[]
  duties        BazarDuty[]
  adjustments   MemberAdjustment[]

  @@unique([messId, year, month])
  @@index([messId, status])
  @@map("mess_months")
}

model MealTypeSetting {
  id              String   @id @default(uuid())
  monthId         String
  month           MessMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)
  mealType        MealType
  enabled         Boolean  @default(true)
  defaultOn       Boolean  @default(false)
  cutoffMinutes   Int      // minutes from local midnight (Asia/Dhaka)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([monthId, mealType])
  @@map("meal_type_settings")
}

model MealRecord {
  id          String           @id @default(uuid())
  messId      String
  mess        Mess             @relation(fields: [messId], references: [id], onDelete: Cascade)
  monthId     String
  month       MessMonth        @relation(fields: [monthId], references: [id], onDelete: Cascade)
  memberId    String
  member      MessMembership   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  date        DateTime         @db.Date
  mealType    MealType
  status      MealRecordStatus
  source      MealChangeSource @default(MEMBER)
  changedById String?
  changedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([messId, memberId, date, mealType])
  @@index([monthId, date])
  @@index([messId, date])
  @@map("meal_records")
}

model GuestMealRecord {
  id          String         @id @default(uuid())
  messId      String
  mess        Mess           @relation(fields: [messId], references: [id], onDelete: Cascade)
  monthId     String
  month       MessMonth      @relation(fields: [monthId], references: [id], onDelete: Cascade)
  memberId    String
  member      MessMembership @relation(fields: [memberId], references: [id], onDelete: Restrict)
  date        DateTime       @db.Date
  mealType    MealType
  guestCount  Int
  changedById String?
  changedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([messId, memberId, date, mealType])
  @@index([monthId, date])
  @@map("guest_meal_records")
}

model DailyMenu {
  id         String   @id @default(uuid())
  messId     String
  mess       Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
  monthId    String
  month      MessMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  mealType   MealType
  menuText   String
  noticeText String?
  updatedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([messId, date, mealType])
  @@index([monthId, date])
  @@map("daily_menus")
}

// =============================================================================
// GROCERY CATALOGUE + PRICES
// =============================================================================

enum Unit {
  KG
  GRAM
  LITRE
  ML
  PIECE
  DOZEN
  PACKET
  BOTTLE
}

enum PriceSource {
  MANAGER_ENTRY
  VERIFIED_PURCHASE
  ADMIN_REFERENCE
  RETAILER_FEED
  AI_ESTIMATE
}

enum PriceVerification {
  UNVERIFIED
  VERIFIED
  OUTDATED
}

model GroceryItem {
  id        String   @id @default(uuid())
  messId    String?  // null => global/shared catalogue entry
  mess      Mess?    @relation(fields: [messId], references: [id], onDelete: Cascade)
  nameEn    String
  nameBn    String
  aliases   String[] @default([])
  category  String
  unit      Unit     @default(KG)
  brand     String?
  isActive  Boolean  @default(true)
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prices     GroceryPrice[]
  masterPrice GroceryMasterPrice?
  bazarItems BazarEntryItem[]

  @@index([category, isActive])
  @@index([messId])
  @@map("grocery_items")
}

model GroceryPrice {
  id            String            @id @default(uuid())
  messId        String
  mess          Mess              @relation(fields: [messId], references: [id], onDelete: Cascade)
  groceryItemId String
  groceryItem   GroceryItem       @relation(fields: [groceryItemId], references: [id], onDelete: Restrict)
  pricePoisha   BigInt
  unit          Unit
  source        PriceSource
  verification  PriceVerification @default(UNVERIFIED)
  shopName      String?
  location      String?
  observedOn    DateTime          @db.Date
  enteredById   String
  createdAt     DateTime          @default(now())

  @@index([messId, groceryItemId, observedOn])
  @@map("grocery_prices")
}

model GroceryMasterPrice {
  id                   String      @id @default(uuid())
  sourceItemId         String      @unique
  groceryItemId        String      @unique
  groceryItem          GroceryItem @relation(fields: [groceryItemId], references: [id], onDelete: Cascade)
  unitLabel            String
  minPricePoisha       BigInt
  maxPricePoisha       BigInt
  referencePricePoisha BigInt
  sourceNote           String
  sourceUrl            String
  checkedOn            DateTime    @db.Date
  priceType            String
  isActive             Boolean     @default(true)
  notes                String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([isActive, checkedOn])
  @@map("grocery_master_prices")
}

// =============================================================================
// MONEY: DEPOSITS, EXPENSES, ALLOCATIONS, ADJUSTMENTS
// =============================================================================

enum DepositStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  CARD
  ROCKET
  BANK
  OTHER
}

model Deposit {
  id           String        @id @default(uuid())
  messId       String
  mess         Mess          @relation(fields: [messId], references: [id], onDelete: Cascade)
  monthId      String
  month        MessMonth     @relation(fields: [monthId], references: [id], onDelete: Restrict)
  memberId     String
  member       MessMembership @relation(fields: [memberId], references: [id], onDelete: Restrict)
  amountPoisha BigInt
  method       PaymentMethod @default(CASH)
  reference    String?
  status       DepositStatus @default(PENDING)
  note         String?
  submittedById String
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  utilityPaymentId String?   @unique
  utilityPayment UtilityPayment? @relation(fields: [utilityPaymentId], references: [id], onDelete: Cascade)

  @@index([messId, monthId, status])
  @@index([memberId])
  @@map("deposits")
}

enum ExpenseCategory {
  MEAL_BAZAR
  RENT
  ELECTRICITY
  GAS
  WATER
  MAID
  GARBAGE
  WIFI
  CLEANING
  OTHER_SHARED
  MEMBER_SPECIFIC
  REFUND_ADJUSTMENT
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  REVERSED
}

enum AllocationMethod {
  EQUAL
  MEAL_COUNT
  CUSTOM
}

model Expense {
  id               String           @id @default(uuid())
  messId           String
  mess             Mess             @relation(fields: [messId], references: [id], onDelete: Cascade)
  monthId          String
  month            MessMonth        @relation(fields: [monthId], references: [id], onDelete: Restrict)
  category         ExpenseCategory
  amountPoisha     BigInt
  description      String
  allocationMethod AllocationMethod @default(EQUAL)
  status           ExpenseStatus    @default(PENDING)
  incurredOn       DateTime         @db.Date
  note             String?
  createdById      String
  approvedById     String?
  approvedAt       DateTime?
  rejectionReason  String?
  utilityBillPaid  Boolean          @default(false)
  utilityBillPaidById String?
  utilityBillPaidAt DateTime?
  reversalOfId     String?          @unique
  reversalOf       Expense?         @relation("ExpenseReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy       Expense?         @relation("ExpenseReversal")
  bazarEntryId     String?          @unique
  bazarEntry       BazarEntry?      @relation(fields: [bazarEntryId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  allocations ExpenseAllocation[]
  utilityPayments UtilityPayment[]

  @@index([messId, monthId, status, category])
  @@index([monthId])
  @@map("expenses")
}

model ExpenseAllocation {
  id           String        @id @default(uuid())
  expenseId    String
  expense      Expense       @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  memberId     String
  member       MessMembership @relation(fields: [memberId], references: [id], onDelete: Restrict)
  amountPoisha BigInt
  mealCount    Int?
  createdAt    DateTime      @default(now())

  @@unique([expenseId, memberId])
  @@index([memberId])
  @@map("expense_allocations")
}

enum UtilityPaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model UtilityPayment {
  id              String               @id @default(uuid())
  expenseId       String
  expense         Expense              @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  memberId        String
  member          MessMembership       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  amountPoisha    BigInt
  method          PaymentMethod
  reference       String?
  note            String?
  status          UtilityPaymentStatus @default(PENDING)
  submittedById   String
  verifiedById    String?
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deposit         Deposit?

  @@unique([expenseId, memberId])
  @@index([expenseId, status])
  @@index([memberId])
  @@map("utility_payments")
}

enum AdjustmentType {
  CREDIT
  DEBIT
}

model MemberAdjustment {
  id           String         @id @default(uuid())
  messId       String
  mess         Mess           @relation(fields: [messId], references: [id], onDelete: Cascade)
  monthId      String
  month        MessMonth      @relation(fields: [monthId], references: [id], onDelete: Restrict)
  memberId     String
  member       MessMembership @relation(fields: [memberId], references: [id], onDelete: Restrict)
  type         AdjustmentType
  amountPoisha BigInt
  reason       String
  createdById  String
  createdAt    DateTime       @default(now())

  @@index([messId, monthId])
  @@index([memberId])
  @@map("member_adjustments")
}

// =============================================================================
// BAZAR
// =============================================================================

enum BazarStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model BazarEntry {
  id             String         @id @default(uuid())
  messId         String
  mess           Mess           @relation(fields: [messId], references: [id], onDelete: Cascade)
  monthId        String
  month          MessMonth      @relation(fields: [monthId], references: [id], onDelete: Restrict)
  buyerMemberId  String
  buyer          MessMembership @relation("BazarBuyer", fields: [buyerMemberId], references: [id], onDelete: Restrict)
  purchaseDate   DateTime       @db.Date
  shopName       String?
  totalPoisha    BigInt
  paymentMethod  PaymentMethod  @default(CASH)
  notes          String?
  status         BazarStatus    @default(DRAFT)
  submittedAt    DateTime?
  reviewedById   String?
  reviewedAt     DateTime?
  rejectionReason String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items         BazarEntryItem[]
  media         Media[]
  aiExtractions AIExtraction[]
  expense       Expense?

  @@index([messId, monthId, status])
  @@index([buyerMemberId])
  @@map("bazar_entries")
}

model BazarEntryItem {
  id                 String       @id @default(uuid())
  bazarEntryId       String
  bazarEntry         BazarEntry   @relation(fields: [bazarEntryId], references: [id], onDelete: Cascade)
  groceryItemId      String?
  groceryItem        GroceryItem? @relation(fields: [groceryItemId], references: [id], onDelete: SetNull)
  itemNameSnapshot   String
  itemNameBnSnapshot String?
  unitSnapshot       Unit
  quantity           Decimal      @db.Decimal(12, 3)
  unitPricePoisha    BigInt
  lineTotalPoisha    BigInt
  confidence         Float?
  source             PriceSource?
  createdAt          DateTime     @default(now())

  @@index([bazarEntryId])
  @@index([groceryItemId])
  @@map("bazar_entry_items")
}

enum DutyStatus {
  SCHEDULED
  COMPLETED
  SKIPPED
}

model BazarDuty {
  id               String         @id @default(uuid())
  messId           String
  mess             Mess           @relation(fields: [messId], references: [id], onDelete: Cascade)
  monthId          String
  month            MessMonth      @relation(fields: [monthId], references: [id], onDelete: Restrict)
  date             DateTime       @db.Date
  assigneeMemberId String?
  assignee         MessMembership? @relation("DutyAssignee", fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  status           DutyStatus     @default(SCHEDULED)
  isManualOverride Boolean        @default(false)
  overrideReason   String?
  completedAt      DateTime?
  createdById      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([messId, date])
  @@index([monthId, date])
  @@index([assigneeMemberId])
  @@map("bazar_duties")
}

// =============================================================================
// MEDIA / AI / AUDIT
// =============================================================================

enum MediaKind {
  BAZAR_PHOTO
  RECEIPT
  AVATAR
  PROOF
  OTHER
}

model Media {
  id           String    @id @default(uuid())
  messId       String?
  mess         Mess?     @relation(fields: [messId], references: [id], onDelete: Cascade)
  kind         MediaKind @default(BAZAR_PHOTO)
  provider     String    @default("cloudinary")
  publicId     String
  resourceType String    @default("image")
  secureUrl    String?
  bytes        Int?
  mimeType     String?
  width        Int?
  height       Int?
  bazarEntryId String?
  bazarEntry   BazarEntry? @relation(fields: [bazarEntryId], references: [id], onDelete: SetNull)
  uploadedById String
  createdAt    DateTime  @default(now())

  @@index([messId, kind])
  @@index([bazarEntryId])
  @@map("media")
}

enum AIExtractionStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

model AIExtraction {
  id               String             @id @default(uuid())
  messId           String
  mess             Mess               @relation(fields: [messId], references: [id], onDelete: Cascade)
  bazarEntryId     String?
  bazarEntry       BazarEntry?        @relation(fields: [bazarEntryId], references: [id], onDelete: SetNull)
  provider         String
  model            String
  taskType         String
  status           AIExtractionStatus @default(QUEUED)
  parsed           Json?
  confidence       Float?
  errorMessage     String?
  tokensPrompt     Int?
  tokensCompletion Int?
  createdById      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([messId, status])
  @@map("ai_extractions")
}

model AuditLog {
  id          String   @id @default(uuid())
  messId      String?
  mess        Mess?    @relation(fields: [messId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  entityType  String
  entityId    String
  action      String
  before      Json?
  after       Json?
  reason      String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([messId, entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}
